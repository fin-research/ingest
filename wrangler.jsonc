{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ARTICLE_API_BASE_URL": "https://eastmoney.hasbai.xyz/api",
    "AI_GATEWAY_ID": "default"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "*/5 0-9 * * MON-FRI"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eastmoney",
      "database_id": "b80cfbe1-1226-46cc-a22b-3ebbaefe85bf",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "binding": "ARTICLE_WORKFLOW",
      "name": "article",
      "class_name": "ArticleWorkflow"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTICLE_BUCKET",
      "bucket_name": "article"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ai_search": [
    {
      "binding": "FINANCE_SEARCH",
      "instance_name": "finance",
      "remote": true
    }
  ]
}
